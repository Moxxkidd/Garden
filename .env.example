# Garden local demo defaults
# Copy this file to .env for local development.

GARDEN_PROJECT_NAME=Garden
GARDEN_PROJECT_VERSION=0.1.0
GARDEN_ENVIRONMENT=development
GARDEN_LOG_LEVEL=INFO

# Local API host/port used by `make dev` or `make demo`
GARDEN_API_HOST=127.0.0.1
GARDEN_API_PORT=8000

# Local SQLite database for the default demo workflow
GARDEN_DATABASE_URL=sqlite+pysqlite:///./data/garden.db

# Safe-by-default guardrail: keep false for local/demo use only
GARDEN_ALLOW_NON_LOCAL_TARGETS=false

# Demo credential values for local-only walkthroughs and example login configs
GARDEN_DEMO_ADMIN_PASSWORD=demo-admin-password
GARDEN_DEMO_USER_PASSWORD=demo-user-password
