{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Garden",
  "version": "2.0.0",
  "identifier": "com.garden.beta",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "resources": {
      "engine-dist/garden-engine/": "engine/",
      "engine-dist/browsers/": "browsers/",
      "engine-dist/notices/": "notices/",
      "../build-versions.json": "build-versions.json"
    },
    "macOS": {
      "minimumSystemVersion": "26.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "requireSignedVersion": true
    }
  }
}
